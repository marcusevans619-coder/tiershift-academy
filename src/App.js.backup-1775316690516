function ModuleStudyPage({ moduleId, user, onBack }) {
  const [module, setModule] = useState(null);
  const [currentTab, setCurrentTab] = useState('lessons'); // 'lessons', 'quiz', 'resources'
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchModule = async () => {
      try {
        const { data, error } = await supabase
          .from('modules')
          .select('*')
          .eq('id', moduleId)
          .single();

        if (error) throw error;
        setModule(data);
      } catch (err) {
        console.error('Error fetching module:', err);
      } finally {
        setLoading(false);
      }
    };

    fetchModule();
  }, [moduleId]);

  if (loading) return <div className="page-loading">Loading module...</div>;
  if (!module) return <div className="page-loading">Module not found</div>;

  return (
    <div className="module-study-page">
      <div className="study-header">
        <button className="btn-back" onClick={onBack}>← Back to Modules</button>
        <h1>{module.name}</h1>
        <p className="module-meta">{module.hours} hours • {module.level} Level</p>
      </div>

      <div className="study-tabs">
        <button
          className={`tab-button ${currentTab === 'lessons' ? 'active' : ''}`}
          onClick={() => setCurrentTab('lessons')}
        >
          📚 Lessons
        </button>
        <button
          className={`tab-button ${currentTab === 'quiz' ? 'active' : ''}`}
          onClick={() => setCurrentTab('quiz')}
        >
          ✏️ Quiz
        </button>
        <button
          className={`tab-button ${currentTab === 'resources' ? 'active' : ''}`}
          onClick={() => setCurrentTab('resources')}
        >
          📎 Resources
        </button>
      </div>

      <div className="study-content">
        {currentTab === 'lessons' && (
          <LessonsViewer moduleId={moduleId} onComplete={() => setCurrentTab('quiz')} />
        )}
        {currentTab === 'quiz' && (
          <QuizViewer moduleId={moduleId} user={user} onComplete={onBack} />
        )}
        {currentTab === 'resources' && (
          <CourseResources moduleId={moduleId} />
        )}
      </div>
    </div>
  );
}

export { LessonsViewer, QuizViewer, CourseResources, ModuleStudyPage };


